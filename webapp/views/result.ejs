<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Screening Outcome - ASD Platform</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body class="home-page">
    <nav>
        <div class="left">
            <a href="/home">Home</a>
            <a href="/screen">New Screening</a>
            <a href="/dashboard">Patient Records</a>
            <a href="/community">Community</a>
            <a href="/about">About</a>
        </div>
        <div class="right">
            <span class="user-greeting">Hi, <%= user.username %></span>
            <button><a href="/logout">Logout</a></button>
        </div>
    </nav>

    <div class="result-container">
        <h2>Clinical Decision Support Summary</h2>
        <p class="subtitle">Evaluated on <%= new Date(record.createdAt).toLocaleDateString() %></p>

        <div class="result-card">
            <div class="metric-block">
                <h3>Toddler Profile</h3>
                <p><strong><%= record.toddlerName %></strong> (<%= record.ageMonths %> months, <%= record.sex === 'm' ? 'Male' : 'Female' %>)</p>
            </div>

            <div class="metric-block">
                <h3>Q-CHAT-10 Checklist Score</h3>
                <span class="score-badge"><%= record.qchatScore %> / 10</span>
            </div>

            <div class="metric-block">
                <h3>ANN Risk Assessment</h3>
                <span class="risk-badge <%= record.prediction.riskTier.toLowerCase().replace(' ', '-') %>">
                    <%= record.prediction.riskTier %>
                </span>
                <p style="margin-top: 8px;">Confidence Probability: <strong><%= (record.prediction.probability * 100).toFixed(1) %>%</strong></p>
            </div>

            <div class="recommendation-block">
                <h4>Clinical Recommendation:</h4>
                <p><%= record.prediction.recommendation %></p>
            </div>
        </div>

        <div class="actions">
            <a href="/dashboard" class="btn-primary">View in History</a>
            <button onclick="window.print()" class="btn-secondary">Print Report</button>
        </div>
    </div>
</body>
</html>