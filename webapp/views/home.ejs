<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>ASD Clinical Screening & Care Platform</title>
</head>

<body class="home-page">
    <nav>
        <div class="left">
            <a href="/home">Home</a>
            <a href="/screen">Screening Assessment</a>
            <a href="/dashboard">Patient Records</a>
            <a href="/community">Support Community</a>
            <a href="/about">About</a>
        </div>
        <div class="right">
            <% if (user) { %>
                <span class="user-greeting">Hi, <%= user.username %></span>
                <button><a href="/logout">Logout</a></button>
            <% } else { %>
                <button><a href="/signup">Sign Up</a></button>
                <button><a href="/login">Login</a></button>
            <% } %>
        </div>
    </nav>

    <section class="hero">
        <div class="hero-content">
            <h1>Early Autism Detection & Clinical Guidance</h1>
            <p>Empowering parents, caregivers, and pediatricians through Artificial Neural Network inference.</p>
            <p>Complete the validated Q-CHAT-10 screening checklist to assess developmental milestones.</p>
            <div class="search-box">
                <% if (user) { %>
                    <a href="/screen" class="btn-primary">Start Screening Assessment</a>
                <% } else { %>
                    <a href="/login" class="btn-primary">Sign In to Screen</a>
                <% } %>
            </div>
        </div>
        <img src="/autism-hero.png" alt="Autism Core Trait Dimensions" class="hero-image">
    </section>

    <section class="info-section">
        <h2>Autism Spectrum Information & Support Pathways</h2>
        <div class="info-cards">
            <div class="card">
                <img src="/login.jpeg" alt="Clinical Diagnosis">
                <h3><a href="/about">Diagnostic Methodologies</a></h3>
                <p>Learn how neural networks evaluate multi-dimensional behavioral responses against clinical benchmarks.</p>
            </div>
            <div class="card">
                <img src="/home page img 1.jpg" alt="Toddler Development">
                <h3><a href="https://www.cdc.gov/autism/signs-symptoms/index.html" target="_blank" rel="noopener">Developmental Milestones</a></h3>
                <p>Observe social communication, sensory reactivity, and joint attention markers in toddlers aged 12–36 months.</p>
            </div>
            <div class="card">
                <img src="/home page img 2.jpg" alt="Caregiver Community">
                <h3><a href="/community">Peer & Caregiver Support</a></h3>
                <p>Connect with other parents, discuss strategies, and share access to early intervention resources.</p>
            </div>
        </div>
    </section>

    <footer class="footer">
        <h3>Autism Spectrum Disorder (ASD) Neural Screening System</h3>
        <p>A clinical decision-support tool. Not a substitute for formal psychiatric evaluation.</p>
    </footer>
</body>

</html>