<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - ASD Platform</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body class="login">
    <div class="container">
        <div class="glass-card">
            <div class="left-card">
                <h1>Sign In</h1>
                <p>Access your screening records & clinical tools</p>
                <% if (error) { %>
                    <div class="alert-error"><%= error %></div>
                <% } %>
                <form action="/login" method="POST">
                    <input type="text" name="username" placeholder="Username or Email" required>
                    <input type="password" name="password" placeholder="Password" required>
                    <button type="submit">Login</button>
                </form>
                <p style="margin-top: 15px;">Don't have an account? <a href="/signup" style="color: #2b6cb0; font-weight: bold;">Register here</a></p>
            </div>
            <div class="right-card">
                <h1>ASD Clinical Assistant</h1>
                <p>Securely store toddler assessment histories, track milestone evaluations, and consult the caregiver community.</p>
            </div>
        </div>
    </div>
</body>
</html>